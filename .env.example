# Jexactyl — so o `docker compose` le este arquivo. Copie para `.env`.

# Imagem oficial (pt-BR embutido).
PANEL_IMAGE=ghcr.io/next-panel/jexactyl-br:latest
PANEL_PORT=8085
APP_URL=http://localhost:8085
APP_LOCALE=pt-BR
TRUSTED_PROXIES=*

# Banco (TROQUE em producao).
DB_DATABASE=jexactyl
DB_USERNAME=jexactyl
DB_PASSWORD=jexactyl_dev
DB_ROOT_PASSWORD=jexactyl_root_dev

# Admin do primeiro boot (apague apos logar). Em migracoes nao precisa.
PANEL_ADMIN_EMAIL=
PANEL_ADMIN_PASSWORD=
PANEL_ADMIN_USERNAME=admin

# Faturamento (stripe|mercadopago). Stripe usa a chave secreta; Mercado Pago usa token.
BILLING_ENABLED=true
BILLING_GATEWAY=stripe
BILLING_SECRET_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SANDBOX=true

# E-mail (opcional).
# MAIL_MAILER=smtp
# MAIL_HOST=mail.exemplo.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="painel@exemplo.com"
