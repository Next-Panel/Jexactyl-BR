From: Matheus Biolowons <30575805+Ashu11-A@users.noreply.github.com>
Date: Tue, 27 Oct 2026 09:53:04 -0300
Subject: i18n: traduz mensagens de erro e tempo limite na camada de cliente HTTP

Description:
Traduz as mensagens de tempo de execução disparadas pelos clientes de API de
autenticação e gerenciamento de arquivos, incluindo falhas de resposta no
fluxo de login e avisos de processamento demorado ao compactar ou extrair
arquivos do servidor.

Origin: vendor
Forwarded: not-needed
Applied-Upstream: no
Last-Update: 2026-10-27
Signed-off-by: Matheus Biolowons <30575805+Ashu11-A@users.noreply.github.com>

---

diff --git a/resources/scripts/api/routes/auth/login.ts b/resources/scripts/api/routes/auth/login.ts
index dd1f72787..3cf033201 100644
--- a/resources/scripts/api/routes/auth/login.ts
+++ b/resources/scripts/api/routes/auth/login.ts
@@ -13,7 +13,7 @@ const login = ({ username, password, recaptchaData }: LoginData): Promise<AuthRe
             )
             .then(response => {
                 if (!(response.data instanceof Object)) {
-                    return reject(new Error('An error occurred while processing the login request.'));
+                    return reject(new Error('Ocorreu um erro ao processar a solicitação de login.'));
                 }
 
                 return resolve({
diff --git a/resources/scripts/api/routes/server/files.ts b/resources/scripts/api/routes/server/files.ts
index f9eee8ced..30ebfd114 100644
--- a/resources/scripts/api/routes/server/files.ts
+++ b/resources/scripts/api/routes/server/files.ts
@@ -16,7 +16,7 @@ const compressFiles = async (uuid: string, directory: string, files: string[]):
         {
             timeout: 10000,
             timeoutErrorMessage:
-                'It looks like this archive is taking a long time to generate. It will appear once completed.',
+                'Parece que este arquivo está demorando muito para ser gerado. Ele aparecerá assim que estiver concluído.',
         },
     );
 
@@ -30,7 +30,7 @@ const decompressFiles = async (uuid: string, directory: string, file: string): P
         {
             timeout: 10000,
             timeoutErrorMessage:
-                'It looks like this archive is taking a long time to be unarchived. Once completed the unarchived files will appear.',
+                'Parece que este arquivo está demorando muito para ser extraído. Assim que concluído, os arquivos extraídos aparecerão.',
         },
     );
 };
