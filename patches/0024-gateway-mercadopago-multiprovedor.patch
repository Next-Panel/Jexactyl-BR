+export interface MercadoPagoCheckout {
+    url: string;
+    preference_id: string;
+}
+
+export const createMercadoPagoCheckoutSession = (
+    product_id: number,
+    node_id?: number,
+    server_id?: number,
+    variables?: BillingServerVariables[],
+    discount_code?: string,
+    egg_id?: number,
+): Promise<MercadoPagoCheckout> => {
+    return new Promise((resolve, reject) => {
+        http.post(`/api/client/billing/mercadopago/create`, {
+            node_id,
+            server_id,
+            product_id,
+            variables,
+            discount_code,
+            egg_id,
+        })
+            .then(({ data }) => resolve(data))
+            .catch(reject);
+    });
+};
+
+export const processMercadoPagoCheckoutSession = (preference_id: string): Promise<Server> => {
+    return new Promise((resolve, reject) => {
+        http.post(`/api/client/billing/mercadopago/process`, { preference_id })
+            .then(({ data }) => resolve(Transformers.toServer(data)))
+            .catch(reject);
+    });
+};
