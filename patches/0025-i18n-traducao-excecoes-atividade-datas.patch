+    /**
+     * Resolve a descricao no idioma do solicitante a partir dos arquivos
+     * de lang (activity.*). Cai para o texto gravado quando nao ha chave.
+     */
+    protected function translatedDescription(ActivityLog $model): ?string
+    {
+        $key = 'activity.' . str_replace(':', '.', $model->event);
+
+        if (!Lang::has($key)) {
+            return $model->description;
+        }
+
+        $raw = $model->properties;
+        $props = $raw instanceof Collection ? $raw->toArray() : (array) $raw;
+
+        $replacements = [];
+        foreach ($props as $name => $value) {
+            if (is_scalar($value) && preg_match('/^[A-Za-z0-9_]+$/', (string) $name)) {
+                $replacements[$name] = $value;
+            }
+        }
+
+        $translated = trans($key, $replacements);
+
+        return is_string($translated) ? $translated : $model->description;
+    }
+
